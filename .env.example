# PostgreSQL
POSTGRES_DB=kanbanchik
POSTGRES_USER=kanbanchik
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_CONNECTION_URL=postgresql://kanbanchik:change_me@postgres:5432/kanbanchik

# Backend
DATABASE_URL=postgresql://kanbanchik:change_me@postgres:5432/kanbanchik
PORT=3001
NODE_ENV=development
AI_PROVIDER=groq
AUTO_SEED_DEMO=true
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
JWT_SECRET=change_me_jwt_secret

MATTERMOST_ENABLED=true
MATTERMOST_URL=https://your-mattermost.example.com
GITLAB_ENABLED=false
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3001/api/v1/auth/gitlab/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000,app://-
CORS_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MATTERMOST_ENABLED=true
NEXT_PUBLIC_GITLAB_ENABLED=false

# Common
BACKEND_PORT=3001
FRONTEND_PORT=3000
